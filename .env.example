# ---------------------------------------------------------------
# Cheeko — settings template. THIS file is committed; `.env` is not.
#
#   cp .env.example .env      then fill in the values
#   node tools/build-env.mjs  writes assets/js/core/env.js
#
# READ THIS FIRST — a browser has no secrets.
# Every CHEEKO_PUBLIC_* value is written into env.js and served to
# the browser, so it is visible in page source to anyone who opens
# the site. The ones listed here are safe to expose by design.
# Anything NOT prefixed CHEEKO_PUBLIC_ is ignored by the generator
# and never reaches the browser — that is where a real secret goes,
# for the backend to read. Never rename a backend secret into the
# CHEEKO_PUBLIC_ namespace to "make it load".
# ---------------------------------------------------------------

# --- public: relays the Contact Support form to an inbox ---
# From web3forms.com — enter the inbox address and the key arrives by
# email. Submit-only: it can post to that one inbox and nothing else.
# While empty, the support form reports a send failure instead of
# pretending the message went out.
CHEEKO_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- public: Firebase project, from Console -> Project settings ---
# These identify the project rather than authorise anything. What
# guards it is the Authorised domains list in Firebase Console ->
# Authentication -> Settings, plus security rules on any database
# added later. See the README before deploying to a new domain.
CHEEKO_PUBLIC_FIREBASE_API_KEY=
CHEEKO_PUBLIC_FIREBASE_AUTH_DOMAIN=
CHEEKO_PUBLIC_FIREBASE_PROJECT_ID=
CHEEKO_PUBLIC_FIREBASE_STORAGE_BUCKET=
CHEEKO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
CHEEKO_PUBLIC_FIREBASE_APP_ID=
# Only used if Analytics is switched on — see the README.
CHEEKO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- public: the parent-profile backend ---
# The SAME API the Parent App uses, so both clients read and write one
# parent account. Mirrors the app's lib/services/api_config_service.dart,
# which has carried these three hosts from the start.
#
# Registering writes TWO rows, both under {base}/toy/api/mobile:
#   POST /user-state       the account-existence row
#   POST /parent-profile   the human details
#
# Which of the three URLs below is used is decided by
# CHEEKO_PUBLIC_API_ENV. Leave a URL empty to make that environment
# unavailable.
CHEEKO_PUBLIC_API_BASE_URL_PRODUCTION=https://ota.cheekoai.in
CHEEKO_PUBLIC_API_BASE_URL_DEVELOPMENT=https://otadev.cheekoai.in
# The backend's own port when running it on this machine — its plan
# documents /health on 8002. It must allow http://localhost:3000 as a
# CORS origin, same as the hosted ones.
CHEEKO_PUBLIC_API_BASE_URL_LOCAL=http://localhost:8002

# Which environment to talk to: production | development | local
#
# DEVELOPMENT ON PURPOSE, not production. Production's CORS allowlist
# does not yet include this site's domain, so pointing a browser there
# gives an opaque "TypeError: Failed to fetch" with nothing to read.
# Verification work belongs on dev anyway.
#
# Leave EMPTY (or empty the selected URL) to fall back to the built-in
# localStorage stand-in, which walks the whole sign-up flow with no
# backend and no CORS at all. That is the only way to work when no
# backend is reachable, so it is a supported state, not a bug.
#
# Overridable at runtime without a rebuild: ?api=dev, ?api=production,
# ?api=local, ?api=standin — the choice sticks until ?api=clear.
CHEEKO_PUBLIC_API_ENV=development

# ---------------------------------------------------------------
# Backend-only settings. The generator skips every key without the
# CHEEKO_PUBLIC_ prefix, so nothing below is served to the browser.
# ---------------------------------------------------------------

# FIREBASE_SERVICE_ACCOUNT_JSON=
# DATABASE_URL=
